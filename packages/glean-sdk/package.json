{
  "name": "@glean/sdk",
  "version": "1.0.0",
  "description": "Glean TypeScript SDK - 完整封装所有 REST API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "files": ["dist", "README.md"],
  "keywords": ["glean", "sdk", "api-client"],
  "license": "MIT",
  "engines": { "node": ">=24.22.1 <25" },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
